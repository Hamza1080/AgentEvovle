# ============================================================
# Python Backend Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- LLM API Keys ---
# OpenAI API Key (required if MODEL_NAME=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (required if MODEL_NAME=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# --- Output ---
# Directory where results/plans will be saved
# Use relative path like ./results or an absolute path
OUTPUT_DIR=./results

# --- Model Configuration ---
# Which LLM backend to use: openai | gemini | ollama
MODEL_NAME=openai

# If MODEL_NAME=ollama, specify which local model to use
OLLAMA_MODEL=qwen2.5:3b

# --- Dataset ---
# Which split of TravelPlanner benchmark to run: validation | test
SET_TYPE=validation

# --- Planning Strategy ---
# Which planning pipeline to use: evoagent | direct | cot | react | reflexion
STRATEGY=evoagent
